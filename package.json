{
  "name": "resconate",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "node tools/build-web.mjs",
    "start": "node tools/dev.mjs --production",
    "db:migrate": "npm run migrate --workspace backend",
    "db:seed": "npm run seed --workspace backend",
    "test": "npm run test --workspace backend",
    "test:e2e": "node tools/e2e.mjs",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "playwright-core": "^1.58.2"
  }
}
