# Copy to .env. Never commit the populated file.
# Core: use a separate least-privilege PostgreSQL database in production.
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
WEB_HOST=127.0.0.1
API_PORT=3001
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://resconate:resconate_local@127.0.0.1:55439/resconate
DATABASE_SSL=false
TEST_DATABASE_URL=postgresql://resconate:resconate_local@127.0.0.1:55439/resconate_test
# Set only to the number of trusted reverse proxies between the API and the client.
TRUST_PROXY_HOPS=0
# Server only. Use Paystack test keys for acceptance tests, live keys for launch.
PAYSTACK_SECRET_KEY=
# Meta WhatsApp Cloud API: permanent token, subscribed phone and app signing secret.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# SMTP account (587 + STARTTLS, or 465 + secure=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SUPPORT_EMAIL=
# Long random secret for POST /api/jobs/process when using an external scheduler.
# The persistent Node server also runs outbox delivery and reconciliation every 30s.
CRON_SECRET=
# Used only by explicit db:seed in development; never enabled in production.
SEED_EMAIL=owner@resconate.local
SEED_PASSWORD=
# Docker Compose only: required and must match the password in DATABASE_URL.
POSTGRES_PASSWORD=
